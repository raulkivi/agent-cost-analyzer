{
  "name": "agent-cost-analyzer",
  "private": true,
  "version": "0.11.0",
  "description": "Agent Cost Analyzer: local app to understand and optimize agentic coding costs — learn how prompt caching and token accounting work, analyze your own Copilot Chat, Claude Code, pi and mitmproxy sessions turn by turn, audit tool calls, and export metadata for AI-assisted cost advice. Also builds the Copilot-only AI Credits Analyzer VS Code extension. Monorepo root.",
  "license": "MIT",
  "author": "Raul Kivi",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulkivi/agent-cost-analyzer.git"
  },
  "homepage": "https://github.com/raulkivi/agent-cost-analyzer#readme",
  "bugs": {
    "url": "https://github.com/raulkivi/agent-cost-analyzer/issues"
  },
  "workspaces": [
    "packages/domain",
    "packages/web",
    "packages/mcp-apps",
    "packages/server",
    "packages/pi-system-prompt-logger",
    "packages/vscode-extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server & npm run dev --workspace=packages/web",
    "start": "bash scripts/dev-open.sh",
    "configure": "bash scripts/install.sh",
    "unconfigure": "bash scripts/uninstall.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "headers:check": "node scripts/spdx-headers.mjs --check",
    "headers:fix": "node scripts/spdx-headers.mjs --fix",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "mcp": "bash scripts/mcp-server.sh",
    "scenarios:docs": "npm run scenarios:docs --workspace=packages/server",
    "scenarios:docs:check": "npm run scenarios:docs:check --workspace=packages/server",
    "vendor-prices:diff": "tsx packages/server/scripts/vendor-prices-diff.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "undici": "^8.12.2",
    "@vscode/test-cli": {
      "mocha": "^12.0.3"
    }
  }
}
