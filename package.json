{
  "name": "agent-cost-analyzer-monorepo",
  "private": true,
  "version": "0.16.1",
  "description": "Agent Cost Analyzer: local app to understand and optimize agentic coding costs — learn how prompt caching and token accounting work, analyze your own Copilot Chat, Claude Code, pi and mitmproxy sessions turn by turn, audit tool calls, and export metadata for AI-assisted cost advice. Also builds the Copilot-only AI Credits Analyzer VS Code extension. Monorepo root.",
  "license": "MIT",
  "author": "Raul Kivi",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulkivi/agent-cost-analyzer.git"
  },
  "homepage": "https://github.com/raulkivi/agent-cost-analyzer#readme",
  "bugs": {
    "url": "https://github.com/raulkivi/agent-cost-analyzer/issues"
  },
  "workspaces": [
    "packages/domain",
    "packages/web",
    "packages/mcp-apps",
    "packages/server",
    "packages/pi-system-prompt-logger",
    "packages/vscode-extension",
    "packages/cli",
    "packages/cli-alias"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server & npm run dev --workspace=packages/web",
    "start": "bash scripts/dev-open.sh",
    "configure": "bash scripts/install.sh",
    "unconfigure": "bash scripts/uninstall.sh",
    "build": "npm run build --workspaces --if-present && npm run build:cli",
    "build:cli": "node packages/cli/scripts/build.mts",
    "smoke:npm-package": "tsx scripts/npm-package-smoke.mts",
    "test": "npm run test --workspaces --if-present && npm run test:cli && npm run test:cli-alias",
    "test:cli": "vitest run --root packages/cli",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/cli-alias/tsconfig.json",
    "lint": "eslint .",
    "headers:check": "node scripts/spdx-headers.mjs --check",
    "headers:fix": "node scripts/spdx-headers.mjs --fix",
    "test:real-data": "npm run test:real-data --workspace=packages/server",
    "test:real-data:savings": "npm run test:real-data:savings --workspace=packages/server",
    "test:real-data:pi": "npm run test:real-data:pi --workspace=packages/server",
    "fixtures:generate-pi": "npm run fixtures:generate-pi --workspace=packages/server --",
    "test:real-data:replay": "npm run test:real-data:replay --workspace=packages/server",
    "test:real-data:cost-by-project": "npm run test:real-data:cost-by-project --workspace=packages/server",
    "test:real-data:allowance": "npm run test:real-data:allowance --workspace=packages/server",
    "test:real-data:tool-audit": "npm run test:real-data:tool-audit --workspace=packages/server",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "mcp": "bash scripts/mcp-server.sh",
    "scenarios:docs": "npm run scenarios:docs --workspace=packages/server",
    "scenarios:docs:check": "npm run scenarios:docs:check --workspace=packages/server",
    "vendor-prices:diff": "tsx packages/server/scripts/vendor-prices-diff.mts",
    "test:cli-alias": "vitest run --root packages/cli-alias"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "^8.12.2",
    "basic-ftp": "^6.2.4",
    "@vscode/test-cli": {
      "mocha": "^12.0.3"
    }
  }
}
