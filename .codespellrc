# Spelling: US English plus common typos. The Spelling workflow checks commit
# messages and added lines in pull requests; existing text is not checked.
# For a proper name in British spelling, add `codespell:ignore <word>` on the line.
[codespell]
builtin = clear,rare,en-GB_to_en-US
uri-ignore-words-list = *
# Fixtures hold recorded or synthetic third-party data verbatim (such as British spellings in Agent Host logs).
skip = *.lock,package-lock.json,*.svg,*.min.js,*.map,*/fixtures/*
# Code identifiers codespell splits into words (atLeast, afterAll).
ignore-words-list = afterall,atleast
