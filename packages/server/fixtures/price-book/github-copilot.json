    },
    {
      "id": "anthropic-pc-pricing-1h",
      "title": "Anthropic: Prompt caching, pricing (1-hour cache writes)",
      "url": "https://platform.claude.com/docs/en/build-with-claude/prompt-caching#pricing",
      "quote": "Cache write tokens with a 1-hour TTL are 2 times the base input tokens price.",
      "checkedAt": "2026-11-04"
    },
    {
      "id": "anthropic-pc-tier-length",
      "title": "Anthropic: Prompt caching, pricing (prompt-length tiers)",
      "url": "https://platform.claude.com/docs/en/build-with-claude/prompt-caching#pricing",
      "quote": "On a model priced by prompt length, cache reads and cache writes count toward a request's prompt length.",
      "checkedAt": "2026-11-04"
    },
    {
      "id": "gh-models-pricing-anthropic",
      "title": "GitHub Docs: Models and pricing for GitHub Copilot",
