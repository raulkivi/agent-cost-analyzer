  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
