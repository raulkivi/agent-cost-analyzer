{
  "name": "@agent-cost-analyzer/server",
  "private": true,
  "version": "0.14.0",
  "license": "MIT",
  "author": "Raul Kivi",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:real-data": "REAL_DATA=1 vitest run scripts/sa18-subagent-credits.real.test.mts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "tsx src/mcp/stdio.ts",
    "scenarios:docs": "tsx scripts/scenarios-docs.mts",
    "scenarios:docs:check": "tsx scripts/scenarios-docs.mts --check"
  },
  "dependencies": {
    "@agent-cost-analyzer/domain": "*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "^5.3.0",
    "gpt-tokenizer": "^4.1.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
