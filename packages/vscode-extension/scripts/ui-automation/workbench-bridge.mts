// Normal mode for the real-Copilot suite (docs/plans/release-ui-gate.md G3).
// wdio-vscode-service starts VS Code with --extensionTestsPath (its proxy, which
// serves browser.executeWorkbench), and VS Code then keeps application and
// shared storage, and so the secret store, in memory: the copied profile's
// GitHub sign-in is never read. The suite instead overrides that argument
// with an empty value (VS Code reads it as no tests location) and loads the
// same proxy from this bridge, a throwaway extension installed into the
// launch's extensions dir. Test-only: it is written into the run's temporary
// copy and is never part of the .vsix or the default suite.
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const PUBLISHER = "aica-test";
const NAME = "wdio-workbench-bridge";
export const BRIDGE_EXTENSION_ID = `${PUBLISHER}.${NAME}`;
export const BRIDGE_VERSION = "0.0.1";

// The suite's `vscodeArgs` for normal mode. wdio-vscode-service merges
// { ...its args, ...vscodeArgs }, so the same camelCase key replaces its
// --extensionTestsPath; VS Code treats the empty value as unset. In normal
// mode VS Code also opens a shared storage database, by default in the
// owner's ~/.vscode-shared: the run keeps it in its own storage instead.
export function normalModeVscodeArgs(storagePath: string): Record<string, string> {
  return { extensionTestsPath: "", "shared-data-dir": path.join(storagePath, "shared-data") };
}

// The ESM module the service's test-runner entry (proxy/cjs/entry.js) imports.
export function wdioProxyModule(): string {
  return path.join(path.dirname(fileURLToPath(import.meta.resolve("wdio-vscode-service"))), "proxy", "index.js");
}

export function bridgeManifest() {
  return {
    name: NAME,
    publisher: PUBLISHER,
    displayName: "AI Credits Analyzer test bridge (wdio)",
    description: "Test-only: serves wdio-vscode-service's executeWorkbench in a normal-mode VS Code.",
    version: BRIDGE_VERSION,
    private: true,
    engines: { vscode: "^1.90.0" },
    // As early as possible: the specs wait on executeWorkbench.
    activationEvents: ["*"],
    main: "./extension.js",
  };
}

// The proxy connects to the port the service wrote into the user settings
// (wdioVSCodeService.proxy.port) and runs what the specs send; it gets this
// extension's `vscode` API, as the service's entry.js passes its own.
function bridgeSource(proxyModule: string): string {
  return [
    `"use strict";`,
    `// Generated by scripts/ui-automation/workbench-bridge.mts for one test run.`,
    `const { pathToFileURL } = require("node:url");`,
    `exports.activate = async () => {`,
    `  const vscode = require("vscode");`,
    `  const { run } = await import(pathToFileURL(${JSON.stringify(proxyModule)}).href);`,
    `  void run(vscode);`,
    `};`,
    `exports.deactivate = () => undefined;`,
    ``,
  ].join("\n");
}

interface ManifestEntry {
  identifier: { id: string };
  [key: string]: unknown;
}

// VS Code lists a profile's extensions in <extensions dir>/extensions.json.
function listExtension(extensionsDir: string, folder: string): void {
  const file = path.join(extensionsDir, "extensions.json");
  let entries: ManifestEntry[] = [];
  try {
    entries = JSON.parse(readFileSync(file, "utf-8")) as ManifestEntry[];
  } catch {
    // None yet.
  }
  const others = entries.filter((entry) => entry.identifier.id !== BRIDGE_EXTENSION_ID);
  const bridge = {
    identifier: { id: BRIDGE_EXTENSION_ID },
    version: BRIDGE_VERSION,
    location: { $mid: 1, path: path.join(extensionsDir, folder), scheme: "file" },
    relativeLocation: folder,
  };
  writeFileSync(file, JSON.stringify([...others, bridge]));
}

export interface InstallBridgeOptions {
  extensionsDir: string;
  proxyModule: string;
}

export function installWorkbenchBridge({ extensionsDir, proxyModule }: InstallBridgeOptions): void {
  const folder = `${BRIDGE_EXTENSION_ID}-${BRIDGE_VERSION}`;
  const dir = path.join(extensionsDir, folder);
  mkdirSync(dir, { recursive: true });
  writeFileSync(path.join(dir, "package.json"), JSON.stringify(bridgeManifest(), null, 2));
  writeFileSync(path.join(dir, "extension.js"), bridgeSource(proxyModule));
  listExtension(extensionsDir, folder);
}
