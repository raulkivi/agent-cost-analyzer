{
  "name": "ai-credits-analyzer",
  "displayName": "AI Credits Analyzer",
  "description": "See where your GitHub Copilot Chat tokens and AI Credits go: prompt caching, per-turn cost, tool-call failures and insights, from your local logs.",
  "version": "0.1.0",
  "publisher": "raulkivi",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulkivi/copilot-cost-analyzer.git"
  },
  "homepage": "https://github.com/raulkivi/copilot-cost-analyzer#readme",
  "bugs": {
    "url": "https://github.com/raulkivi/copilot-cost-analyzer/issues"
  },
  "keywords": [
    "copilot",
    "github copilot",
    "copilot chat",
    "ai credits",
    "tokens",
    "token usage",
    "cost",
    "prompt caching",
    "llm",
    "agent",
    "mcp"
  ],
  "categories": [
    "Visualization",
    "AI",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.143.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCreditsAnalyzer.open",
        "title": "Open",
        "category": "AI Credits Analyzer",
        "icon": "$(graph)"
      },
      {
        "command": "aiCreditsAnalyzer.refreshSessions",
        "title": "Refresh",
        "category": "AI Credits Analyzer",
        "icon": "$(refresh)"
      },
      {
        "command": "aiCreditsAnalyzer.openSession",
        "title": "Open Session",
        "category": "AI Credits Analyzer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aiCreditsAnalyzer.showToolAudit",
        "title": "Show Tool Audit",
        "category": "AI Credits Analyzer",
        "icon": "$(checklist)"
      },
      {
        "command": "aiCreditsAnalyzer.copyAdviceBundle",
        "title": "Copy Advice Bundle",
        "category": "AI Credits Analyzer",
        "icon": "$(copy)"
      },
      {
        "command": "aiCreditsAnalyzer.fixSetting",
        "title": "Fix Setting",
        "category": "AI Credits Analyzer",
        "icon": "$(wrench)"
      },
      {
        "command": "aiCreditsAnalyzer.openLearnMode",
        "title": "Open Learn Mode",
        "category": "AI Credits Analyzer",
        "icon": "$(mortar-board)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiCreditsAnalyzer",
          "title": "AI Credits Analyzer",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "aiCreditsAnalyzer": [
        {
          "id": "aiCreditsAnalyzer.sessions",
          "name": "Sessions"
        },
        {
          "id": "aiCreditsAnalyzer.setup",
          "name": "Setup"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiCreditsAnalyzer.sessions",
        "contents": "No Copilot Chat sessions with token data yet.\n\nWhile you wait, see how caching and AI Credits work with sample sessions.\n[Open Learn mode](command:aiCreditsAnalyzer.openLearnMode)"
      },
      {
        "view": "aiCreditsAnalyzer.setup",
        "contents": "No setup problems found. Sessions record token data while Copilot Chat debug logging is on and enough sessions are kept.\n[Review the debug logging setting](command:aiCreditsAnalyzer.fixSetting)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiCreditsAnalyzer.openSession",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.showToolAudit",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.copyAdviceBundle",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aiCreditsAnalyzer.refreshSessions",
          "when": "view == aiCreditsAnalyzer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "aiCreditsAnalyzer.open",
          "when": "view == aiCreditsAnalyzer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "aiCreditsAnalyzer.refreshSessions",
          "when": "view == aiCreditsAnalyzer.setup",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "view == aiCreditsAnalyzer.setup && viewItem == aiCreditsAnalyzer.setupWarning",
          "group": "inline"
        },
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "view == aiCreditsAnalyzer.setup && viewItem == aiCreditsAnalyzer.setupWarning",
          "group": "navigation"
        },
        {
          "command": "aiCreditsAnalyzer.openSession",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@1"
        },
        {
          "command": "aiCreditsAnalyzer.showToolAudit",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@2"
        },
        {
          "command": "aiCreditsAnalyzer.copyAdviceBundle",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:extension --prefix ../web && node scripts/build.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@copilot-cost-analyzer/domain": "*",
    "@copilot-cost-analyzer/server": "*",
    "@types/vscode": "1.140.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
