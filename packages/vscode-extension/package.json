{
  "name": "ai-credits-analyzer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.12.0",
  "publisher": "raulkivi",
  "icon": "icon.png",
  "private": true,
  "license": "MIT",
  "author": "Raul Kivi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulkivi/agent-cost-analyzer.git"
  },
  "homepage": "https://github.com/raulkivi/agent-cost-analyzer#readme",
  "bugs": {
    "url": "https://github.com/raulkivi/agent-cost-analyzer/issues"
  },
  "keywords": [
    "copilot",
    "github copilot",
    "copilot chat",
    "ai credits",
    "tokens",
    "token usage",
    "cost",
    "prompt caching",
    "llm",
    "agent",
    "mcp"
  ],
  "categories": [
    "Visualization",
    "AI",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.146.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "aiCreditsAnalyzer.mcp.enabled"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCreditsAnalyzer.open",
        "title": "%command.open.title%",
        "category": "%category%",
        "icon": "$(graph)"
      },
      {
        "command": "aiCreditsAnalyzer.refreshSessions",
        "title": "%command.refreshSessions.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "aiCreditsAnalyzer.openSession",
        "title": "%command.openSession.title%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aiCreditsAnalyzer.openScenario",
        "title": "%command.openScenario.title%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aiCreditsAnalyzer.showToolAudit",
        "title": "%command.showToolAudit.title%",
        "category": "%category%",
        "icon": "$(checklist)"
      },
      {
        "command": "aiCreditsAnalyzer.copyAdviceBundle",
        "title": "%command.copyAdviceBundle.title%",
        "category": "%category%",
        "icon": "$(copy)"
      },
      {
        "command": "aiCreditsAnalyzer.fixSetting",
        "title": "%command.fixSetting.title%",
        "category": "%category%",
        "icon": "$(wrench)"
      },
      {
        "command": "aiCreditsAnalyzer.openLearnMode",
        "title": "%command.openLearnMode.title%",
        "category": "%category%",
        "icon": "$(mortar-board)"
      },
      {
        "command": "aiCreditsAnalyzer.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "%category%",
        "icon": "$(book)"
      },
      {
        "command": "aiCreditsAnalyzer.groupSessionsByRepository",
        "title": "%command.groupSessionsByRepository.title%",
        "category": "%category%",
        "icon": "$(repo)"
      },
      {
        "command": "aiCreditsAnalyzer.groupSessionsByDay",
        "title": "%command.groupSessionsByDay.title%",
        "category": "%category%",
        "icon": "$(calendar)"
      },
      {
        "command": "aiCreditsAnalyzer.setMonthlyAllowance",
        "title": "%command.setMonthlyAllowance.title%",
        "category": "%category%",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiCreditsAnalyzer",
          "title": "%viewsContainer.title%",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "aiCreditsAnalyzer": [
        {
          "id": "aiCreditsAnalyzer.sessions",
          "name": "%view.sessions.name%"
        },
        {
          "id": "aiCreditsAnalyzer.learn",
          "name": "%view.learn.name%"
        },
        {
          "id": "aiCreditsAnalyzer.setup",
          "name": "%view.setup.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiCreditsAnalyzer.sessions",
        "contents": "%welcome.sessions%"
      },
      {
        "view": "aiCreditsAnalyzer.learn",
        "contents": "%welcome.learn%"
      },
      {
        "view": "aiCreditsAnalyzer.setup",
        "contents": "%welcome.setup%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "aiCreditsAnalyzer.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "order": 1,
          "markdownDescription": "%configuration.mcp.enabled.markdownDescription%"
        },
        "aiCreditsAnalyzer.monthlyAllowance.aiCredits": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "application",
          "order": 2,
          "markdownDescription": "%configuration.monthlyAllowance.aiCredits.markdownDescription%"
        },
        "aiCreditsAnalyzer.monthlyAllowance.resetDay": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 28,
          "scope": "application",
          "order": 3,
          "markdownDescription": "%configuration.monthlyAllowance.resetDay.markdownDescription%"
        },
        "aiCreditsAnalyzer.monthlyAllowance.warnAtPercent": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "scope": "application",
          "order": 4,
          "markdownDescription": "%configuration.monthlyAllowance.warnAtPercent.markdownDescription%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "aiCreditsAnalyzer.mcp",
        "label": "%mcpServerDefinitionProvider.label%"
      }
    ],
    "walkthroughs": [
      {
        "id": "aiCreditsAnalyzer.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "aiCreditsAnalyzer.enableLogging",
            "title": "%walkthrough.step.enableLogging.title%",
            "description": "%walkthrough.step.enableLogging.description%",
            "media": {
              "image": "resources/walkthrough/enable-logging.svg",
              "altText": "%walkthrough.step.enableLogging.altText%"
            },
            "completionEvents": [
              "onSettingChanged:github.copilot.chat.agentDebugLog.fileLogging.enabled"
            ]
          },
          {
            "id": "aiCreditsAnalyzer.keepSessions",
            "title": "%walkthrough.step.keepSessions.title%",
            "description": "%walkthrough.step.keepSessions.description%",
            "media": {
              "image": "resources/walkthrough/keep-sessions.svg",
              "altText": "%walkthrough.step.keepSessions.altText%"
            },
            "completionEvents": [
              "onSettingChanged:github.copilot.chat.agentDebugLog.fileLogging.maxRetainedSessionLogs"
            ]
          },
          {
            "id": "aiCreditsAnalyzer.openSession",
            "title": "%walkthrough.step.openSession.title%",
            "description": "%walkthrough.step.openSession.description%",
            "media": {
              "image": "resources/walkthrough/sessions-view.svg",
              "altText": "%walkthrough.step.openSession.altText%"
            },
            "completionEvents": [
              "onCommand:aiCreditsAnalyzer.openSession",
              "onCommand:aiCreditsAnalyzer.open"
            ]
          },
          {
            "id": "aiCreditsAnalyzer.learnCaching",
            "title": "%walkthrough.step.learnCaching.title%",
            "description": "%walkthrough.step.learnCaching.description%",
            "media": {
              "image": "resources/walkthrough/prompt-caching.svg",
              "altText": "%walkthrough.step.learnCaching.altText%"
            },
            "completionEvents": [
              "onCommand:aiCreditsAnalyzer.openLearnMode"
            ]
          },
          {
            "id": "aiCreditsAnalyzer.askCopilot",
            "title": "%walkthrough.step.askCopilot.title%",
            "description": "%walkthrough.step.askCopilot.description%",
            "media": {
              "markdown": "resources/walkthrough/mcp.md"
            },
            "completionEvents": [
              "onSettingChanged:aiCreditsAnalyzer.mcp.enabled"
            ]
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiCreditsAnalyzer.openScenario",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.showToolAudit",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.copyAdviceBundle",
          "when": "false"
        },
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aiCreditsAnalyzer.groupSessionsByRepository",
          "when": "view == aiCreditsAnalyzer.sessions && aiCreditsAnalyzer.sessionsGrouping != repository",
          "group": "navigation@0"
        },
        {
          "command": "aiCreditsAnalyzer.groupSessionsByDay",
          "when": "view == aiCreditsAnalyzer.sessions && aiCreditsAnalyzer.sessionsGrouping == repository",
          "group": "navigation@0"
        },
        {
          "command": "aiCreditsAnalyzer.refreshSessions",
          "when": "view == aiCreditsAnalyzer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "aiCreditsAnalyzer.open",
          "when": "view == aiCreditsAnalyzer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "aiCreditsAnalyzer.refreshSessions",
          "when": "view == aiCreditsAnalyzer.setup",
          "group": "navigation@1"
        },
        {
          "command": "aiCreditsAnalyzer.open",
          "when": "view == aiCreditsAnalyzer.learn",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "view == aiCreditsAnalyzer.setup && viewItem == aiCreditsAnalyzer.setupWarning",
          "group": "inline"
        },
        {
          "command": "aiCreditsAnalyzer.fixSetting",
          "when": "view == aiCreditsAnalyzer.setup && viewItem == aiCreditsAnalyzer.setupWarning",
          "group": "navigation"
        },
        {
          "command": "aiCreditsAnalyzer.openSession",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@1"
        },
        {
          "command": "aiCreditsAnalyzer.showToolAudit",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@2"
        },
        {
          "command": "aiCreditsAnalyzer.copyAdviceBundle",
          "when": "view == aiCreditsAnalyzer.sessions && viewItem == aiCreditsAnalyzer.session",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build --prefix ../mcp-apps && npm run build:extension --prefix ../web && node scripts/build.mts",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:integration": "node scripts/build-integration-tests.mts && vscode-test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/test/integration/tsconfig.json && tsc --noEmit -p test/ui/tsconfig.json",
    "test:ui": "tsx scripts/ui-check/ui-check.mts",
    "screenshots": "tsx scripts/ui-check/screenshots.mts",
    "demo:gif": "tsx scripts/demo/make-gif.mts",
    "demo:record": "env -u WAYLAND_DISPLAY xvfb-run -a -s \"-screen 0 1600x1000x24\" wdio run wdio.demo.conf.mts",
    "demo:record:copilot": "env -u WAYLAND_DISPLAY xvfb-run -a -s \"-screen 0 1600x1000x24\" wdio run wdio.demo-copilot.conf.mts",
    "demo:record:desktop": "tsx scripts/demo/desktop/record-desktop.mts",
    "test:ui:vscode": "wdio run wdio.conf.mts",
    "test:ui:vscode:copilot": "wdio run wdio.copilot.conf.mts",
    "record:host-themes": "wdio run wdio.record.conf.mts",
    "test:ui:vscode:copilot:signin": "node scripts/copilot-e2e-signin.mts",
    "release:evidence": "node scripts/release-evidence-check.mts"
  },
  "devDependencies": {
    "@agent-cost-analyzer/domain": "*",
    "@agent-cost-analyzer/server": "*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "@wdio/cli": "9.33.1",
    "@wdio/globals": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/reporter": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "vitest": "^5.0.5",
    "wdio-vscode-service": "8.0.0",
    "webdriverio": "9.33.1"
  }
}
