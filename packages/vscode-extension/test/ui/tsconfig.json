{
  // The VS Code UI automation (step 10.16) runs under WebdriverIO and mocha in
  // Node, driving a real VS Code, so it type-checks with their globals, which
  // the unit tests (vitest) must not see; the package tsconfig excludes this
  // folder. wdio.conf.mts type-checks with it.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework", "wdio-vscode-service", "expect-webdriverio"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["./**/*.ts", "./**/*.mts", "../../wdio.conf.mts", "../../scripts/ui-automation/*.mts"],
  "exclude": []
}
