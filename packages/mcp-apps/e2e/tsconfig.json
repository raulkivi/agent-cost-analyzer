{
  // The fake-host suite (step 10.17 G5) runs in Node under Playwright Test;
  // host/host-page.ts runs in the host page. Both type-check here, apart
  // from the views' own tsconfig.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.mts"],
  "exclude": ["./host/dist", "./out"]
}
